{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MarkDo main window: native open/save dialogs, file read/write, print",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-print",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
