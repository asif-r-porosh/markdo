{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkDo",
  "version": "0.1.0",
  "identifier": "online.uraal.markdo",
  "build": {
    "frontendDist": "../../dist",
    "beforeBuildCommand": "sh ../scripts/stage.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "MarkDo", "width": 1280, "height": 820, "minWidth": 720, "minHeight": 520 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
